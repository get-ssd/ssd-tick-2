{
  "manifest_version": 3,
  "name": "SSD â€” Signed, Sealed, Delivered",
  "version": "0.4.9",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://m.facebook.com/*",
    "https://www.reddit.com/*",
    "https://old.reddit.com/*",
    "https://twitter.com/*",
    "https://x.com/*",
    "https://idltd.github.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost:8099/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "exclude_matches": ["http://localhost/social-mock/*", "http://127.0.0.1/social-mock/*"],
      "js": [
        "core/cfg.js",
        "core/token-parser.js",
        "core/canon.js",
        "core/keyring.js",
        "core/vault.js",
        "core/verifier.js",
        "scanners/text-scanner.js",
        "scanners/image-scanner.js",
        "core/platforms.js",
        "ui/badge.js",
        "ui/popup.js",
        "test/bootstrap.js"
      ],
      "css": ["ui/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost/social-mock/facebook*", "http://127.0.0.1/social-mock/facebook*"],
      "js": [
        "core/cfg.js",
        "core/token-parser.js",
        "core/canon.js",
        "core/keyring.js",
        "core/vault.js",
        "core/verifier.js",
        "scanners/text-scanner.js",
        "scanners/image-scanner.js",
        "core/platforms.js",
        "ui/badge.js",
        "ui/popup.js",
        "analyser/panel.js",
        "analyser/searcher.js",
        "analyser/analyser.js",
        "platforms/facebook.js"
      ],
      "css": ["ui/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost/social-mock/x*", "http://127.0.0.1/social-mock/x*"],
      "js": [
        "core/cfg.js",
        "core/token-parser.js",
        "core/canon.js",
        "core/keyring.js",
        "core/vault.js",
        "core/verifier.js",
        "scanners/text-scanner.js",
        "scanners/image-scanner.js",
        "core/platforms.js",
        "ui/badge.js",
        "ui/popup.js",
        "analyser/panel.js",
        "analyser/searcher.js",
        "analyser/analyser.js",
        "platforms/twitter.js"
      ],
      "css": ["ui/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost/social-mock/reddit*", "http://127.0.0.1/social-mock/reddit*"],
      "js": [
        "core/cfg.js",
        "core/token-parser.js",
        "core/canon.js",
        "core/keyring.js",
        "core/vault.js",
        "core/verifier.js",
        "scanners/text-scanner.js",
        "scanners/image-scanner.js",
        "core/platforms.js",
        "ui/badge.js",
        "ui/popup.js",
        "platforms/reddit.js"
      ],
      "css": ["ui/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost/social-mock/telegram*", "http://127.0.0.1/social-mock/telegram*"],
      "js": [
        "core/cfg.js",
        "core/token-parser.js",
        "core/canon.js",
        "core/keyring.js",
        "core/vault.js",
        "core/verifier.js",
        "scanners/text-scanner.js",
        "scanners/image-scanner.js",
        "core/platforms.js",
        "ui/badge.js",
        "ui/popup.js",
        "platforms/telegram.js"
      ],
      "css": ["ui/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost/social-mock/whatsapp*", "http://127.0.0.1/social-mock/whatsapp*"],
      "js": [
        "core/cfg.js",
        "core/token-parser.js",
        "core/canon.js",
        "core/keyring.js",
        "core/vault.js",
        "core/verifier.js",
        "scanners/text-scanner.js",
        "scanners/image-scanner.js",
        "core/platforms.js",
        "ui/badge.js",
        "ui/popup.js",
        "platforms/whatsapp.js"
      ],
      "css": ["ui/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/*", "https://m.facebook.com/*"],
      "js": [
        "core/cfg.js",
        "core/token-parser.js",
        "core/canon.js",
        "core/keyring.js",
        "core/vault.js",
        "core/verifier.js",
        "scanners/text-scanner.js",
        "scanners/image-scanner.js",
        "core/platforms.js",
        "ui/badge.js",
        "ui/popup.js",
        "analyser/panel.js",
        "analyser/searcher.js",
        "analyser/analyser.js",
        "platforms/facebook.js"
      ],
      "css": ["ui/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://twitter.com/*", "https://x.com/*"],
      "js": [
        "core/cfg.js",
        "core/token-parser.js",
        "core/canon.js",
        "core/keyring.js",
        "core/vault.js",
        "core/verifier.js",
        "scanners/text-scanner.js",
        "scanners/image-scanner.js",
        "core/platforms.js",
        "ui/badge.js",
        "ui/popup.js",
        "analyser/panel.js",
        "analyser/searcher.js",
        "analyser/analyser.js",
        "platforms/twitter.js"
      ],
      "css": ["ui/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.reddit.com/*", "https://old.reddit.com/*"],
      "js": [
        "core/cfg.js",
        "core/token-parser.js",
        "core/canon.js",
        "core/keyring.js",
        "core/vault.js",
        "core/verifier.js",
        "scanners/text-scanner.js",
        "scanners/image-scanner.js",
        "core/platforms.js",
        "ui/badge.js",
        "ui/popup.js",
        "platforms/reddit.js"
      ],
      "css": ["ui/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16":  "icon-16.png",
    "32":  "icon-32.png",
    "48":  "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icon-16.png",
      "32":  "icon-32.png",
      "48":  "icon-48.png",
      "128": "icon-128.png"
    }
  }
}
