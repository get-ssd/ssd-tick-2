{
  "manifest_version": 3,
  "name": "SSD — Signed, Sealed, Delivered",
  "version": "0.4.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "ssd@idltd.com"
    }
  },
  "permissions": ["storage", "tabs", "contextMenus"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://m.facebook.com/*",
    "https://www.reddit.com/*",
    "https://old.reddit.com/*",
    "https://twitter.com/*",
    "https://x.com/*",
    "https://idltd.github.io/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:8099/*"
  ],
  "background": {
    "scripts": ["background/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:8080/*", "http://127.0.0.1:8080/*"],
      "js": [
        "core/cfg.js",
        "core/token-parser.js",
        "core/canon.js",
        "core/keyring.js",
        "core/vault.js",
        "core/verifier.js",
        "core/signer.js",
        "core/sign-this-text.js",
        "scanners/text-scanner.js",
        "scanners/image-scanner.js",
        "core/platforms.js",
        "ui/badge.js",
        "ui/popup.js",
        "test/bootstrap.js"
      ],
      "css": ["ui/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/*", "https://m.facebook.com/*"],
      "js": [
        "core/cfg.js",
        "core/token-parser.js",
        "core/canon.js",
        "core/keyring.js",
        "core/vault.js",
        "core/verifier.js",
        "core/signer.js",
        "core/sign-this-text.js",
        "scanners/text-scanner.js",
        "scanners/image-scanner.js",
        "core/platforms.js",
        "ui/badge.js",
        "ui/popup.js",
        "analyser/panel.js",
        "analyser/searcher.js",
        "analyser/analyser.js",
        "platforms/facebook.js"
      ],
      "css": ["ui/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://twitter.com/*", "https://x.com/*"],
      "js": [
        "core/cfg.js",
        "core/token-parser.js",
        "core/canon.js",
        "core/keyring.js",
        "core/vault.js",
        "core/verifier.js",
        "core/signer.js",
        "core/sign-this-text.js",
        "scanners/text-scanner.js",
        "scanners/image-scanner.js",
        "core/platforms.js",
        "ui/badge.js",
        "ui/popup.js",
        "analyser/panel.js",
        "analyser/searcher.js",
        "analyser/analyser.js",
        "platforms/twitter.js"
      ],
      "css": ["ui/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.reddit.com/*", "https://old.reddit.com/*"],
      "js": [
        "core/cfg.js",
        "core/token-parser.js",
        "core/canon.js",
        "core/keyring.js",
        "core/vault.js",
        "core/verifier.js",
        "core/signer.js",
        "core/sign-this-text.js",
        "scanners/text-scanner.js",
        "scanners/image-scanner.js",
        "core/platforms.js",
        "ui/badge.js",
        "ui/popup.js",
        "platforms/reddit.js"
      ],
      "css": ["ui/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16":  "icon-16.png",
    "32":  "icon-32.png",
    "48":  "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icon-16.png",
      "32":  "icon-32.png",
      "48":  "icon-48.png",
      "128": "icon-128.png"
    }
  }
}
