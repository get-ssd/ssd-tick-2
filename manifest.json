{
  "manifest_version": 3,
  "name": "SSD — Signed, Sealed, Delivered",
  "version": "0.2.0",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://m.facebook.com/*",
    "https://idltd.github.io/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:8080/*", "http://127.0.0.1:8080/*"],
      "js": [
        "core/token-parser.js",
        "core/canon.js",
        "core/keyring.js",
        "core/vault.js",
        "core/verifier.js",
        "core/signer.js",
        "scanners/text-scanner.js",
        "scanners/image-scanner.js",
        "ui/badge.js",
        "ui/popup.js",
        "test/bootstrap.js"
      ],
      "css": ["ui/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/*", "https://m.facebook.com/*"],
      "js": [
        "core/token-parser.js",
        "core/canon.js",
        "core/keyring.js",
        "core/vault.js",
        "core/verifier.js",
        "core/signer.js",
        "scanners/text-scanner.js",
        "scanners/image-scanner.js",
        "ui/badge.js",
        "ui/popup.js",
        "platforms/facebook.js"
      ],
      "css": ["ui/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16":  "icon-16.png",
    "32":  "icon-32.png",
    "48":  "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icon-16.png",
      "32":  "icon-32.png",
      "48":  "icon-48.png",
      "128": "icon-128.png"
    }
  }
}
